# Z.AI API Configuration
# ========================
# This file contains environment variables for the Synaptrix AI Trading System
# Copy this file to .env and fill in your actual API keys

# Z.AI API Key (REQUIRED for LLM features)
# Get your API key from: https://z.ai/
# The LLM provides:
# - Decision explanations
# - Bias detection
# - Confidence adjustment suggestions
# - Risk notes
ZAI_API_KEY=your_zai_api_key_here

# Brave Search API Key (OPTIONAL - for news features)
# Get your API key from: https://brave.com/search/api/
# Currently not implemented but reserved for future use
BRAVE_API_KEY=your_brave_api_key_here

# ========================
# INSTRUCTIONS:
# ========================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and replace 'your_zai_api_key_here' with your actual Z.AI API key
#
# 3. The system will automatically load the API key from .env file
#
# 4. IMPORTANT: Never commit .env to git! It contains sensitive API keys
#
# 5. .env is already in .gitignore to prevent accidental commits
